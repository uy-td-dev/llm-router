# OpenAI (add OPENAI_API_KEY_2 etc. for extra upstream accounts)
OPENAI_API_KEY=sk-your-key-here
# OPENAI_API_KEY_2=sk-your-second-key

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Google Gemini
GOOGLE_API_KEY=your-key-here

# PostgreSQL (used when database.mode = "postgres")
POSTGRES_URL=postgres://user:password@localhost:5432/llm_router

# Logging
RUST_LOG=info

server:
  host: 0.0.0.0
  port: 8080
providers:
- name: openai
  enabled: true
  api_key: ${OPENAI_API_KEY}
  base_url: https://api.openai.com/v1
  models:
  - name: gpt-4
    cost:
      input_per_1m: 30.0
      output_per_1m: 60.0
    kind: null
  - name: gpt-4-turbo
    cost:
      input_per_1m: 10.0
      output_per_1m: 30.0
    kind: null
  - name: gpt-3.5-turbo
    cost:
      input_per_1m: 0.5
      output_per_1m: 1.5
    kind: null
  - name: text-embedding-3-small
    cost:
      input_per_1m: 0.02
      output_per_1m: 0.0
    kind: embedding
  - name: text-embedding-3-large
    cost:
      input_per_1m: 0.13
      output_per_1m: 0.0
    kind: embedding
  accounts: []
  timeout_ms: 60000
  max_retries: 3
- name: anthropic
  enabled: true
  api_key: ${ANTHROPIC_API_KEY}
  base_url: https://api.anthropic.com/v1
  models:
  - name: claude-haiku-4-5
    cost:
      input_per_1m: 1.0
      output_per_1m: 5.0
    kind: null
  - name: claude-sonnet-4-5
    cost:
      input_per_1m: 3.0
      output_per_1m: 15.0
    kind: null
  - name: claude-3-opus-20240229
    cost:
      input_per_1m: 15.0
      output_per_1m: 75.0
    kind: null
  - name: claude-3-5-sonnet-20241022
    cost:
      input_per_1m: 3.0
      output_per_1m: 15.0
    kind: null
  - name: claude-3-haiku-20240307
    cost:
      input_per_1m: 0.25
      output_per_1m: 1.25
    kind: null
  accounts: []
  timeout_ms: 60000
  max_retries: 3
- name: google
  enabled: true
  api_key: ${GOOGLE_API_KEY}
  base_url: https://generativelanguage.googleapis.com/v1beta
  models:
  - name: gemini-2.5-flash
    cost:
      input_per_1m: 0.3
      output_per_1m: 2.5
    kind: null
  - name: gemini-2.5-pro
    cost:
      input_per_1m: 1.25
      output_per_1m: 10.0
    kind: null
  - name: gemini-1.5-pro
    cost:
      input_per_1m: 3.5
      output_per_1m: 10.5
    kind: null
  - name: gemini-1.5-flash
    cost:
      input_per_1m: 0.35
      output_per_1m: 1.05
    kind: null
  - name: text-embedding-004
    cost:
      input_per_1m: 0.0
      output_per_1m: 0.0
    kind: embedding
  accounts: []
  timeout_ms: 60000
  max_retries: 3
routing:
  default_strategy: cheapest_first
  fallback_chain:
  - provider: openai
    model: gpt-4
  - provider: anthropic
    model: claude-3-opus-20240229
  - provider: google
    model: gemini-1.5-pro
  retry:
    max_attempts: 3
    initial_backoff_ms: 1000
    max_backoff_ms: 30000
    backoff_multiplier: 2.0
  aliases:
    premium:
    - openai/gpt-4
    - anthropic/claude-3-5-sonnet-20241022
    - google/gemini-1.5-pro
    gemini-1.5-pro:
    - google/gemini-1.5-pro
    - anthropic/claude-3-5-sonnet-20241022
    gpt-3.5-turbo:
    - openai/gpt-3.5-turbo
    - google/gemini-1.5-flash
    claude-3-haiku-20240307:
    - anthropic/claude-3-haiku-20240307
    - google/gemini-1.5-flash
    claude-3-opus-20240229:
    - anthropic/claude-3-opus-20240229
    - openai/gpt-4
    - google/gemini-1.5-pro
    fast:
    - google/gemini-1.5-flash
    - openai/gpt-3.5-turbo
    gpt-4:
    - openai/gpt-4
    - anthropic/claude-3-5-sonnet-20241022
    - google/gemini-1.5-pro
    gpt-4-turbo:
    - openai/gpt-4-turbo
    - openai/gpt-4
    - google/gemini-1.5-pro
    gemini-1.5-flash:
    - google/gemini-1.5-flash
    - openai/gpt-3.5-turbo
    claude-3-5-sonnet-20241022:
    - anthropic/claude-3-5-sonnet-20241022
    - openai/gpt-4-turbo
    - google/gemini-1.5-pro
security:
  requests_per_minute: 60
  api_keys: []
  admin_key: null
keys: []
cache:
  enabled: false
  ttl_seconds: 300
  max_entries: 1000
database:
  mode: sqlite
  sqlite:
    path: ../data/llm_router.db
  postgres:
    url: ''
semantic_cache:
  enabled: false
  similarity_threshold: 0.92
  embedding_model: text-embedding-3-small
  ttl_seconds: 300
  max_entries: 100
